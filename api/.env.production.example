# Production uses FTP as the durable media store.
UPLOAD_PROVIDER=ftp
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
# 仅当 FTP PASV 返回受信任的独立/内网数据主机时开启。
FTP_ALLOW_SEPARATE_TRANSFER_HOST=false
FTP_BASE_DIR=
FTP_CDN_DOMAIN=https://

# GPU/ComfyUI remains a generation source only. Its output is copied to FTP.
COMFYUI_PUBLIC_URL=https://
