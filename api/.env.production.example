# Production uses FTP as the durable media store.
UPLOAD_PROVIDER=ftp
FTP_HOST=114.55.25.62
FTP_PORT=21
FTP_USER=z.wellbeing.newstaredu.cn
FTP_PASSWORD=
FTP_SECURE=false
# 新 FTP 的 PASV 会返回受信任的内网数据主机 10.24.19.203。
FTP_ALLOW_SEPARATE_TRANSFER_HOST=true
FTP_BASE_DIR=wellbeing
FTP_CDN_DOMAIN=https://z.wellbeing.newstaredu.cn

# GPU/ComfyUI remains a generation source only. Its output is copied to FTP.
COMFYUI_PUBLIC_URL=https://

# ---- RAGFlow（向量检索 + 使用习惯画像）----
RAGFLOW_ENABLED=false
RAGFLOW_API_URL=http://localhost:9380
RAGFLOW_API_PREFIX=/api/v1
RAGFLOW_API_KEY=
RAGFLOW_PICTUREBOOK_DATASET=picturebook-knowledge
RAGFLOW_HABITS_DATASET=usage-habits

# ---- 使用习惯 ETL（api/scripts/sync-usage-habits.mjs，建议 cron 每日）----
DB_HOST=localhost
DB_PORT=5433
DB_NAME=wellbeing
DB_USER=wellbeing_user
DB_PASSWORD=

# ---- Wiki.js 提示词库（提示词外置到知识库，改提示词无需发版）----
WIKI_PROMPT_ENABLED=false
WIKI_API_URL=http://localhost:3000
WIKI_API_KEY=
WIKI_PROMPT_ROOT=wellbeing/prompts
WIKI_PROMPT_LOCALE=zh
WIKI_PROMPT_CACHE_TTL_SEC=300
