# ============================================================
# 前端 Dockerfile — Vite 静态构建 → Nginx 托管
# ============================================================

# ---- 阶段 1：构建前端 ----
FROM node:22-alpine AS builder

WORKDIR /app

COPY . .

# 便携交付包保留完整工作台构建结果；完整源码仓库仍可从源构建。
RUN if [ -f dist/index.html ] && [ -f dist/workbench-v6/song-music-backend.js ] && [ -f dist/workbench-v6/yoga-existing-backend.js ]; then \
      test -f dist/workbench-v6/manifest.json && test -f dist/workbench-v6/external-manifest.json; \
    else \
      npm ci && npm run build; \
    fi

# ---- 阶段 2：Nginx 运行 ----
FROM nginx:1.27-alpine AS runner

# 移除默认配置
RUN rm /etc/nginx/conf.d/default.conf

# 复制自定义 nginx 配置
COPY docker/nginx.conf /etc/nginx/conf.d/wellbeing.conf

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
