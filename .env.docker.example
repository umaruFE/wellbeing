# ============================================================
# Wellbeing Docker 环境变量配置
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env.docker
#   2. 填写实际值
#   3. 启动：docker compose --env-file .env.docker up -d --build
# ============================================================

# ---- 数据库 ----
DB_NAME=wellbeing
DB_USER=wellbeing_user
DB_PASSWORD=wellbeing_pass_2024

# ---- JWT 密钥（生产环境务必修改）----
JWT_SECRET=wellbeing-secret-key-2024

# ---- n8n 工作流引擎 ----
N8N_API_BASE_URL=http://117.50.218.161:5678
N8N_API_KEY=

# ---- ComfyUI 图片生成 ----
COMFYUI_URL=http://117.50.218.161:8188
COMFYUI_PUBLIC_URL=https://vcbj5meqyp1y7ifw-8188.container.x-gpu.com

# ---- 阿里云 OSS（留空则使用本地上传）----
ALIYUN_OSS_REGION=oss-cn-beijing
ALIYUN_OSS_BUCKET=wellbeing1
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=wellbeing1.oss-cn-beijing.aliyuncs.com
# local = 文件存本地，oss = 存阿里云
UPLOAD_PROVIDER=local

# ---- 第三方 AI 服务（按需填写）----
REMOVEBG_API_KEY=
DASHSCOPE_API_KEY=
