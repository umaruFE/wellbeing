    {
      "name": "查询 ComfyUI 历史",
      "id": "5bd88dd7-1149-4ebc-be3e-4406df4c5314",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "parameters": {
        "options": {},
        "genericAuthType": "httpBearerAuth",
        "authentication": "genericCredentialType",
        "url": "=http://117.50.171.219:8188/history/{{ $json.body.executionId }}"
      },
