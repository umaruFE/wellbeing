        }
      }
    },
    {
      "name": "解析图片状态",
      "id": "8671cb6d-d3a7-4758-bd66-da2089642d91",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const body = $input.first().json || {};\nconst task = Object.values(body)[0];\nif (!task) return [{ json: { status: 'pending' } }];\nconst state = task.status?.status_str;\nif (state === 'error' || state === 'failed') return [{ json: { status: 'error', error: task.status?.error || task.status?.exception || 'ComfyUI execution failed' } }];\nif (state !== 'success' && task.status?.completed !== true) return [{ json: { status: 'pending' } }];\nfor (const output of Object.values(task.outputs || {})) {\n  const image = output?.images?.[0];\n  if (!image) continue;\n  const query = 'filename=' + encodeURIComponent(image.filename) + '&subfolder=' + encodeURIComponent(image.subfolder || '') + '&type=' + encodeURIComponent(image.type || 'output');\n  return [{ json: { status: 'completed', filename: image.filename, url: `http://117.50.218.161:5678/webhook/ai-comfyui-view?${query}` } }];\n}\nreturn [{ json: { status: 'completed' } }];"
      },
      "position": [
        480,
        0
      ]
    },
    {
      "name": "返回状态",
      "id": "4a9fa439-5c24-40fa-9396-637216ab5dee",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "parameters": {
        "options": {},
        "responseBody": "={{ $json }}",
        "respondWith": "json"
      },
      "position": [
        720,
        0
      ]
    }
  ],
