    {
      "name": "准备提示词",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const input = $input.first()?.json || {};\nconst body = input.body || input;\nconst systemPrompt = String(body.systemPrompt || '').trim();\nconst userPrompt = String(body.userPrompt || '').trim();\nif (!systemPrompt || !userPrompt) throw new Error('systemPrompt and userPrompt are required');\nreturn [{ json: { systemPrompt, userPrompt } }];"
      },
      "type": "n8n-nodes-base.code",
      "id": "22863ec9-d011-4ee7-8df2-b8991e546bcb",
      "position": [
        240,
