          "mode": "list",
          "cachedResultName": "deepseek-v4-pro",
          "__rl": true,
          "value": "deepseek-v4-pro"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "id": "71bcf648-40f4-4786-8d03-6088c4d53b30",
