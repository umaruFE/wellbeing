    },
    {
      "name": "整理结果",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const response = $input.first()?.json || {};\nlet content = response.output ?? response.text ?? '';\nif (typeof content !== 'string') content = JSON.stringify(content);\nreturn [{ json: { content: content.trim() } }];"
      },
      "type": "n8n-nodes-base.code",
