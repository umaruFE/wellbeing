      "parameters": {
        "jsCode": "// 获取提示词优化模板\nconst item = $input.first()?.json || {};\nconst taskType = item.body?.task_type || item.task_type || 'extract-keywords';\nconst originalPrompt = item.body?.prompt || item.prompt || '';\nconst selectedRoles = item.body?.selectedRoles || [];\n\nconst systemPrompt = item.body?.promptTemplate;\nif (!systemPrompt) throw new Error('缺少 promptTemplate：后端提示词注册表未下发，请先部署最新 api/src/prompts 再导入本工作流');\n\nreturn [{\n  json: {\n    task_type: taskType,\n    original_prompt: originalPrompt,\n    chatInput: originalPrompt,\n    system_prompt: systemPrompt,\n    selectedRoles: selectedRoles\n  }\n}];"
      },
