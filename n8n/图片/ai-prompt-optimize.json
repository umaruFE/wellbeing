    {
      "parameters": {
        "jsCode": "// 解析 AI Agent 响应\nconst response = $input.first()?.json || {};\n\n// 提取内容\nlet content = '';\nif (response?.output) {\n  content = typeof response.output === 'string' ? response.output : JSON.stringify(response.output);\n} else if (response?.text) {\n  content = response.text;\n}\n\n// 尝试解析 JSON\nlet result = {\n  status: 'success',\n  background: '',\n  roles: {},\n  raw: content\n};\n\n// 清理可能有的 markdown 代码块\ncontent = content.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/\\s*```$/, '').trim();\n\ntry {\n  const json = JSON.parse(content);\n  \n  if (json.background && json.roles) {\n    result.background = json.background;\n    result.roles = json.roles;\n  } else if (json.state || json.cities || json.background || json.roles) {\n    result.background = json.background || json.state || json.scene || '';\n    \n    if (json.cities && Array.isArray(json.cities)) {\n      const roleMap = {};\n      json.cities.forEach(item => {\n        const match = String(item).match(/^([a-zA-Z]+)(.+)$/);\n        if (match) {\n          roleMap[match[1].toLowerCase()] = match[2].trim();\n        }\n      });\n      result.roles = roleMap;\n    } else if (json.roles) {\n      result.roles = json.roles;\n    }\n  }\n} catch (e) {\n  result.raw = content;\n}\n\nreturn [{ json: result }];"
      },
