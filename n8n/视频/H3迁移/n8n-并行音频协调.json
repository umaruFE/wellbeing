    {
      "parameters": {
        "jsCode": "const job=$('Audio input').first().json;\nconst voice=$('🦅单人视频-生成配音').first().json;\nconst music=$input.first().json;\nlet error='';\nif(voice.error || !Array.isArray(voice.data)) error='配音子流程失败：'+JSON.stringify(voice.error || voice);\nelse if(music.error || typeof music.music_filepath !== 'string' || !music.music_filepath) error='音乐子流程失败：'+JSON.stringify(music.error || music);\nreturn [{json:{execution_id:job.job_id,status:error?'error':'success',response:JSON.stringify({job_id:job.job_id,audio_execution_id:$execution.id,voice,music,error,completed_at:Date.now()})}}];"
      },
