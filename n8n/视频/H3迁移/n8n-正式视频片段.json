      "parameters": {
        "jsCode": "const id=$('请求视频生成').first().json.prompt_id;\nif(!id) throw new Error('ComfyUI 未返回 prompt_id');\nconst entry=$input.first().json[id];\nif(Date.now()-$('构建 H3 请求').first().json.started_at>45*60*1000) throw new Error('H3 等待超过45分钟，请检查ComfyUI；服务器任务可能仍在运行');\nif(entry?.status?.status_str==='error') throw new Error('ComfyUI H3 生成失败: '+JSON.stringify(entry.status.messages||[]));\nlet file;\nif(entry?.status?.completed || entry?.status?.status_str==='success') {\n const output=entry.outputs?.['92'];\n for(const list of Object.values(output||{})) {\n  if(Array.isArray(list)) file=list.find(v=>v && typeof v.filename==='string' && /\\.(mp4|mov|webm|mkv)$/i.test(v.filename))||file;\n }\n if(!file) throw new Error('H3 已完成，但 SaveVideo(92) 未返回视频文件: '+JSON.stringify(output));\n}\nreturn [{json:{completed:!!file,filename:file?.filename||'',subfolder:file?.subfolder||'',type:file?.type||'output'}}];"
      }
    },
