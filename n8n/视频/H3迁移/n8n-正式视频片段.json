      "parameters": {
        "jsCode": "const x=$input.first().json;\nif(typeof x.prompt !== 'string' || !x.prompt.trim()) throw new Error('缺少分镜 prompt');\nif(typeof x.image_filepath !== 'string' || !x.image_filepath.trim()) throw new Error('缺少 image_filepath');\nconst duration=Number(x.duration ?? 5);\nif(!Number.isFinite(duration) || duration < 4 || duration > 15) throw new Error('H3 单段 duration 必须为 4–15 秒；请在父流程调整分镜时长');\nlet width=Number(x.width ?? 864), height=Number(x.height ?? 480);\nif(!Number.isFinite(width)||!Number.isFinite(height)||width<256||height<256) throw new Error('宽高必须为不小于256的数字');\nconst scale=Math.min(1,768/Math.min(width,height),1344/Math.max(width,height));\nwidth=Math.max(256,Math.round(width*scale/32)*32);height=Math.max(256,Math.round(height*scale/32)*32);\nconst frames=Math.round(duration*24);const length=frames+((5-frames%17)+17)%17;\nlet image_filepath=x.image_filepath.trim();\nif(!/^https?:\\/\\//i.test(image_filepath) && !image_filepath.startsWith('/home/node/files/')) {\n if(image_filepath.includes('file=')) image_filepath='/home/node/files/'+image_filepath.split('file=').pop().split('?')[0];\n else if(!image_filepath.startsWith('/')) image_filepath='/home/node/files/'+image_filepath;\n}\nconst seed=x.seed==null?Math.floor(Math.random()*2**48):Number(x.seed);\nif(!Number.isSafeInteger(seed)||seed<0) throw new Error('seed 必须为非负安全整数');\nreturn [{json:{prompt:x.prompt.trim(),image_filepath,duration,width,height,length,seed}}];"
      }
    },
